{
  "name": "private-plan-image",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm --filter server dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter server build && pnpm --filter web build",
    "test:web": "pnpm --filter server exec tsx --test ../../packages/web/test/*.test.ts",
    "db:generate": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "sharp", "esbuild"]
  }
}
