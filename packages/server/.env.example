# ── 服务端环境变量 ────────────────────────────────────────────
# 复制到 .env 后启动：cp .env.example .env

# HTTP 监听端口（默认 9990）
PORT=9990

# 运行时数据目录的绝对路径（默认 <project-root>/.data）
# 包含 database / assets / secrets / exports
# 如需自定义路径取消注释并修改：
# DATA_DIR=/absolute/path/to/your/data

# 日志级别：debug | info | warn | error（默认 info）
LOG_LEVEL=info

# 运行环境（默认 development）
NODE_ENV=development

# 管理员登录密码（必填；未配置时服务拒绝登录）
# 请在复制后取消注释并设置强密码，切勿提交实际密码：
# ADMIN_PASSWORD=use-a-strong-unique-password

# ── 注意 ─────────────────────────────────────────────────────
# API 密钥（百炼 / 火山方舟 / GPT中转）不在此处配置。
# 密钥通过设置页写入 $DATA_DIR/secrets/*.json，后端独占访问。
